# Copy to .env.local and fill in. Never commit real keys.
ANTHROPIC_API_KEY=

# 1 = read menus from data/snapshots instead of USC's live site (demo safety net)
DEMO_MODE=0

# Optional: email picks (the email card stays hidden until both are set).
# A team Gmail account with 2-Step Verification on, and an App Password from myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: daily emails. Added automatically when you connect Upstash Redis in Vercel → Storage.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: any long random string; Vercel sends it with cron requests so strangers can't trigger the daily send.
CRON_SECRET=
